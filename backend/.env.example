# Telegram
BOT_TOKEN=123456:ABC...              # от @BotFather
WEBAPP_URL=https://your-app.example  # HTTPS-адрес фронтенда (Mini App)

# База данных. По умолчанию — бесплатный SQLite. Для Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./aifitness.db

# AI. rules (бесплатно, без модели) | ollama (локально, бесплатно) | openai_compat (любой OpenAI-совместимый API — может быть платным)
AI_PROVIDER=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# Разработка: пропустить проверку подписи initData (НИКОГДА не включать в проде)
DEV_SKIP_AUTH=false
UPLOAD_DIR=./uploads
